@page "/Requests/Status/{token}"
@using VolunteerCoordinator.Web.Presentation
@model VolunteerCoordinator.Web.Pages.Requests.StatusModel
@inject GroupTimeFormatter Formatter
@{
    ViewData["Title"] = "Your commitment";
}
<h1 tabindex="-1">Your commitment</h1>
@if (Model.Error is not null)
{
    <div class="alert alert-error" role="alert">@Model.Error</div>
}
else if (Model.Hub is not null)
{
    <article class="card commitment-hub">
        <h2>@Model.Hub.Commitment.ShiftTitle</h2>
        <p class="status-row"><strong>Request:</strong> @Model.Hub.RequestStatus <strong>Assignment:</strong> @(Model.Hub.AssignmentStatus ?? "Not assigned")</p>
        <p role="status">@Model.Hub.StatusMessage</p>
        <p><strong>@Model.Hub.Commitment.SlotLabel</strong> · <time datetime="@Formatter.UtcDateTime(Model.Hub.Commitment.StartsAtUtc)">@Formatter.FormatLocal(Model.Hub.Commitment.StartsAtUtc, Model.Hub.Commitment.GroupTimeZoneId)</time></p>
        @if (Model.Hub.OfferedActions.Count > 0)
        {
            <div class="actions">
                @foreach (var action in Model.Hub.OfferedActions)
                {
                    <form method="post">
                        <input type="hidden" name="action" value="@action" />
                        <button type="submit" class="@(action == "Cancel" ? "button-secondary" : "")">@(action == "Cancel" ? "Cancel commitment" : action + " commitment")</button>
                    </form>
                }
            </div>
        }
        <details class="supporting-details">
            <summary>Full commitment details and instructions</summary>
            <partial name="_CommitmentDetails" model="Model.Hub.Commitment" />
            <p><strong>Volunteer:</strong> @Model.Hub.VolunteerName</p>
        </details>
    </article>
}
