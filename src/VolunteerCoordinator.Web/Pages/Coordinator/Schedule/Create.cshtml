@page "/Coordinator/Schedule/Create"
@using VolunteerCoordinator.Application.Time
@using VolunteerCoordinator.Web.Presentation
@inject GroupTimeFormatter Formatter
@model VolunteerCoordinator.Web.Pages.Coordinator.Schedule.CreateModel
@{
    ViewData["Title"] = "Create shift";
}
<header class="page-heading">
    <div>
        <p class="eyebrow">Schedule setup</p>
        <h1 tabindex="-1">Create schedule entry</h1>
        <p class="lead">Enter the real commitment in the group’s local time. Volunteers will see only the details you mark for them.</p>
    </div>
</header>
@if (Model.Settings is not null)
{
    <p class="field-help">Local time zone: <strong>@Formatter.FriendlyTimeZone(Model.Settings.TimeZoneId)</strong>. If a local time repeats, choose the interpretation that matches the group’s clock.</p>
}
<form method="post">
    <input asp-for="ExpectedSettingsVersion" type="hidden">
    <div asp-validation-summary="All" class="validation-summary-errors" role="alert" aria-live="assertive" tabindex="-1" data-focus-target="@(ViewData.ModelState.IsValid ? "false" : "true")"></div>
    <div class="form-group"><label asp-for="Title"></label><input asp-for="Title"><span asp-validation-for="Title"></span></div>
    <div class="form-group"><label asp-for="Location"></label><input asp-for="Location"><span asp-validation-for="Location"></span></div>
    <div class="form-group"><label asp-for="VolunteerInstructions">Volunteer instructions</label><textarea asp-for="VolunteerInstructions"></textarea><span asp-validation-for="VolunteerInstructions"></span></div>
    <div class="form-group"><label asp-for="Notes">Internal coordinator notes</label><textarea asp-for="Notes"></textarea><span asp-validation-for="Notes"></span></div>
    <fieldset class="form-group">
        <legend>How volunteers sign up</legend>
        <p class="field-help">This one choice applies to every role in this schedule entry.</p>
        <div class="choice-grid">
            <label class="choice-card">
                <input asp-for="SignupPolicy" type="radio" value="ApprovalRequired">
                <strong>Approval required (safer default)</strong>
                <span>A volunteer sends a request. A coordinator reviews it before the commitment is assigned.</span>
            </label>
            <label class="choice-card">
                <input asp-for="SignupPolicy" type="radio" value="DirectClaim">
                <strong>Direct claim (lower maintenance)</strong>
                <span>The first eligible volunteer who submits is confirmed immediately.</span>
            </label>
        </div>
    </fieldset>
    <div class="form-group"><label asp-for="StartsAtLocal">Starts at (local time)</label><input asp-for="StartsAtLocal" type="datetime-local"><span asp-validation-for="StartsAtLocal"></span></div>
    @if (Model.Resolution?.StartCandidates.Count > 0)
    {
        <fieldset class="form-group"><legend>Choose the start interpretation</legend>
        @foreach (var candidate in Model.Resolution.StartCandidates)
        {
            <label><input type="radio" name="StartsAtOffset" value="@TimeZoneLabels.OffsetValue(candidate.UtcOffset)" checked="@(Model.StartsAtOffset == TimeZoneLabels.OffsetValue(candidate.UtcOffset) ? "checked" : null)"> @candidate.ZoneLabel</label>
        }
        </fieldset>
    }
    <div class="form-group"><label asp-for="EndsAtLocal">Ends at (local time)</label><input asp-for="EndsAtLocal" type="datetime-local"><span asp-validation-for="EndsAtLocal"></span></div>
    @if (Model.Resolution?.EndCandidates.Count > 0)
    {
        <fieldset class="form-group"><legend>Choose the end interpretation</legend>
        @foreach (var candidate in Model.Resolution.EndCandidates)
        {
            <label><input type="radio" name="EndsAtOffset" value="@TimeZoneLabels.OffsetValue(candidate.UtcOffset)" checked="@(Model.EndsAtOffset == TimeZoneLabels.OffsetValue(candidate.UtcOffset) ? "checked" : null)"> @candidate.ZoneLabel</label>
        }
        </fieldset>
    }
    <div class="form-group"><label asp-for="BackupSlotCount">Backup slots</label><select asp-for="BackupSlotCount"><option value="0">0</option><option value="1">1</option><option value="2">2</option></select><span asp-validation-for="BackupSlotCount"></span></div>
    <div class="actions"><button type="submit">Create shift</button><a class="button button-secondary" asp-page="/Coordinator/Schedule/Index">Cancel</a></div>
</form>
