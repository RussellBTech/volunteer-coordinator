@page "/Coordinator/Schedule"
@model VolunteerCoordinator.Web.Pages.Coordinator.Schedule.IndexModel
@{
    ViewData["Title"] = "Schedule setup";
}
<header class="page-heading">
    <div>
        <p class="eyebrow">Coordinator workspace</p>
        <h1 tabindex="-1">Schedule</h1>
        <p class="lead">Create and correct service commitments in the group’s local time, then review them before publication.</p>
    </div>
    <div class="actions">
        <a class="button" asp-page="/Coordinator/Schedule/Create">Create schedule entry</a>
        <a class="button button-secondary" asp-page="/Coordinator/Settings">Group settings</a>
    </div>
</header>
@if (TempData["Error"] is string error) { <div class="alert alert-error" role="alert">@error</div> }
@if (Model.Shifts.Count == 0)
{
    <div class="empty-state">
        <p class="eyebrow">No schedule entries</p>
        <h2>Start with the first commitment</h2>
        <p>Enter the real local date, time, location, instructions, and slots for the service work you need covered.</p>
        <a class="button" asp-page="/Coordinator/Schedule/Create">Create the first schedule entry</a>
    </div>
}
else
{
    <div class="grid">
    @foreach (var shift in Model.Shifts)
    {
        <article class="card schedule-card">
            <partial name="_CommitmentDetails" model="shift.Commitment" />
            <div class="status-row" aria-label="Schedule entry status">
                <span class="status-chip">@(shift.IsActive ? "Active" : "Resolved")</span>
                <span class="status-chip">@(shift.IsPublished ? "Published" : "Not published")</span>
            </div>
            <p><strong>Internal coordinator notes:</strong> @(shift.InternalCoordinatorNotes ?? "Not provided")</p>
            <ul class="status-list">
            @foreach (var slot in shift.Slots)
            {
                <li>@(slot.Kind == "Primary" ? "Primary" : $"Backup {slot.Position}"): <strong>@(slot.Status switch { "Assigned" => "Waiting for confirmation", "Confirmed" => "Confirmed", "Open" => "Open", "Inactive" => "Resolved", _ => "Resolved" })</strong></li>
            }
            </ul>
            @if (shift.IsActive)
            {
                <div class="actions">
                    @if (!shift.IsPublished)
                    {
                        <a class="button" asp-page="/Coordinator/Schedule/Publish" asp-route-id="@shift.Id">Review and publish</a>
                    }
                    else
                    {
                        <a class="button" asp-page="/Coordinator/Schedule/Edit" asp-route-id="@shift.Id">Edit entry</a>
                    }
                </div>
                <details class="supporting-details">
                    <summary>Other schedule actions</summary>
                    @if (!shift.IsPublished)
                    {
                        <a class="text-link" asp-page="/Coordinator/Schedule/Edit" asp-route-id="@shift.Id">Edit entry</a>
                    }
                    <p class="field-help">Deactivation supersedes pending requests, cancels active assignments, and invalidates their action links.</p>
                    <a class="text-link danger-link" asp-page="/Coordinator/Schedule/Deactivate" asp-route-id="@shift.Id">Review deactivation</a>
                </details>
            }
        </article>
    }
    </div>
}
