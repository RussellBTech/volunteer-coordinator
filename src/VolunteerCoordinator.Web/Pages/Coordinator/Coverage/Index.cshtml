@page "/Coordinator/Coverage"
@model VolunteerCoordinator.Web.Pages.Coordinator.Coverage.IndexModel
@{
    ViewData["Title"] = "Coverage";
}
<h1>Coverage monitoring</h1>
<p class="lead">Upcoming published slots are ordered by local time, with uncovered and unconfirmed work called out in text.</p>
@if (TempData["Error"] is string error) { <div class="alert alert-error" role="alert">@error</div> }
@if (Model.Coverage.Count == 0)
{
    <div class="empty-state"><h2>No published upcoming slots</h2><p>Create and publish shifts from schedule setup to monitor coverage.</p><a class="button" asp-page="/Coordinator/Schedule/Index">Open schedule setup</a></div>
}
else
{
<div class="table-scroll"><table class="responsive">
<thead><tr><th>Commitment</th><th>Coverage state</th><th>Volunteer</th><th>Intervene</th></tr></thead>
<tbody>
@foreach (var item in Model.Coverage)
{
<tr>
<td data-label="Commitment"><partial name="_CommitmentDetails" model="item.Commitment" /></td>
<td data-label="Coverage state"><span class="badge badge-@item.State.ToLowerInvariant()">@item.State</span></td>
<td data-label="Volunteer">@(item.VolunteerName ?? "No volunteer assigned") @if (item.VolunteerEmail is not null) { <small>@item.VolunteerEmail</small> }</td>
<td data-label="Intervene">
    <div class="actions">
        <a class="button button-secondary" asp-page="/Coordinator/Assignments/Assign" asp-route-slotId="@item.SlotId">@(item.AssignmentId.HasValue ? "Reassign" : "Assign")</a>
        @if (item.AssignmentId is Guid assignmentId)
        {
            <a class="button" asp-page="/Coordinator/Assignments/Links" asp-route-assignmentId="@assignmentId">Action links</a>
            <form method="post" asp-page-handler="Cancel" class="inline">
                <input type="hidden" name="assignmentId" value="@assignmentId">
                <button type="submit" class="button-danger">Cancel assignment</button>
            </form>
        }
    </div>
</td>
</tr>
}
</tbody></table></div>
}
