@page "/Coordinator/Coverage"
@model VolunteerCoordinator.Web.Pages.Coordinator.Coverage.IndexModel
@{
    ViewData["Title"] = "Coverage";
    var heading = Model.AppliedAttention switch
    {
        "uncovered" => "Open commitments",
        "unconfirmed" => "Waiting for confirmation",
        _ => "Coverage"
    };
}
<header class="page-heading">
    <div>
        <p class="eyebrow">Routine work</p>
        <h1 tabindex="-1">@heading</h1>
        <p class="lead">Upcoming published commitments are ordered by local time. Each state is written out so you can act without relying on color.</p>
    </div>
    @if (Model.AppliedAttention is not null)
    {
        <a class="button button-secondary" asp-page="/Coordinator/Coverage/Index">Show all coverage</a>
    }
</header>
@if (TempData["Error"] is string error) { <div class="alert alert-error" role="alert">@error</div> }
@if (Model.Coverage.Count == 0)
{
    <div class="empty-state">
        <p class="eyebrow">No matching work</p>
        <h2>@(Model.AppliedAttention is null ? "No published upcoming commitments" : "Nothing needs attention here")</h2>
        <p>@(Model.AppliedAttention is null ? "Create and publish schedule entries to monitor coverage." : "This attention category is clear.")</p>
        <a class="button button-secondary" asp-page="/Coordinator">Back to coordinator home</a>
    </div>
}
else
{
<div class="table-scroll"><table class="responsive">
<caption class="visually-hidden">Coverage commitments</caption>
<thead><tr><th>Commitment</th><th>Coverage state</th><th>Volunteer</th><th>Next action</th></tr></thead>
<tbody>
@foreach (var item in Model.Coverage)
{
<tr>
<td data-label="Commitment"><partial name="_CommitmentDetails" model="item.Commitment" /></td>
<td data-label="Coverage state"><span class="status-chip status-chip-@item.State.ToLowerInvariant()">@(item.State switch { "Unconfirmed" => "Waiting for confirmation", "Uncovered" => "Open", _ => "Confirmed" })</span></td>
<td data-label="Volunteer">@(item.VolunteerName ?? "No volunteer assigned") @if (item.VolunteerEmail is not null) { <small>@item.VolunteerEmail</small> }</td>
<td data-label="Next action">
    <div class="actions">
        <a class="button button-secondary" asp-page="/Coordinator/Assignments/Assign" asp-route-slotId="@item.SlotId">@(item.AssignmentId.HasValue ? "Replace volunteer" : "Assign volunteer")</a>
        @if (item.AssignmentId is Guid assignmentId)
        {
            <a class="button button-secondary" asp-page="/Coordinator/Assignments/Access" asp-route-assignmentId="@assignmentId">Manage volunteer access</a>
            <a class="button button-danger" asp-page="/Coordinator/Assignments/Cancel" asp-route-assignmentId="@assignmentId">Review cancellation</a>
        }
    </div>
    @if (item.Access is not null)
    {
        <p class="field-help"><strong>Volunteer access:</strong> @item.Access.State</p>
    }
</td>
</tr>
}
</tbody></table></div>
}
