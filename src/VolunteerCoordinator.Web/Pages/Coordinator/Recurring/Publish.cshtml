@page "/Coordinator/Recurring/Publish/{id:guid}"
@model VolunteerCoordinator.Web.Pages.Coordinator.Recurring.PublishModel
@{
    ViewData["Title"] = "Publish recurring occurrences";
}
<header class="page-heading">
    <div>
        <p class="eyebrow">Publication review</p>
        <h1 tabindex="-1">Publish a recurring date range</h1>
        <p class="lead">Every selected local date is checked first. If one blocker remains, no selected shift is published.</p>
    </div>
</header>
<form method="post">
    <div asp-validation-summary="All" class="validation-summary-errors" role="alert"></div>
    <div class="form-group"><label asp-for="FromLocalDate">First local date</label><input asp-for="FromLocalDate" type="date"></div>
    <div class="form-group"><label asp-for="ThroughLocalDate">Last local date</label><input asp-for="ThroughLocalDate" type="date"></div>
    <input asp-for="ExpectedSeriesVersion" type="hidden">
    <input asp-for="ExpectedVersions" type="hidden">
    <div class="actions"><button type="submit" name="handler" value="Preview">Review selected dates</button><a class="button button-secondary" asp-page="/Coordinator/Recurring/Detail" asp-route-id="@Model.SeriesId">Back without changes</a></div>
</form>
@if (Model.Preview is not null)
{
    <section class="card consequence-preview" aria-labelledby="publication-preview-heading">
        <h2 id="publication-preview-heading">Selected dates</h2>
        <ul class="status-list">
        @foreach (var row in Model.Preview.Occurrences)
        {
            <li><strong>@row.LocalDate.ToString("dddd, MMMM d, yyyy")</strong> — @row.Status; @row.DstStatus</li>
        }
        </ul>
        @if (Model.Preview.Blockers.Count > 0)
        {
            <div class="alert alert-warning" role="alert"><strong>Publication is blocked.</strong><ul class="affected-list">@foreach (var blocker in Model.Preview.Blockers) { <li>@blocker.LocalDate.ToString("yyyy-MM-dd"): @blocker.Reason</li> }</ul></div>
        }
        else
        {
            <p>All selected concrete shifts are current and eligible.</p>
            <form method="post"><input asp-for="ExpectedSeriesVersion" type="hidden"><input asp-for="ExpectedVersions" type="hidden"><input asp-for="FromLocalDate" type="hidden"><input asp-for="ThroughLocalDate" type="hidden"><button type="submit" name="handler" value="Confirm">Publish all selected dates</button></form>
        }
    </section>
}
