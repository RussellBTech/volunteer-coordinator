@page "/Coordinator/Settings"
@model VolunteerCoordinator.Web.Pages.Coordinator.SettingsModel
@{
    ViewData["Title"] = "Group settings";
}
<header class="page-heading">
    <div>
        <p class="eyebrow">Coordinator setup</p>
        <h1 tabindex="-1">Group settings</h1>
        <p class="lead">Choose the local time zone used for every schedule and commitment display.</p>
    </div>
</header>
@if (Model.Settings is not null)
{
    <div class="alert alert-warning" role="note">
        Changing the zone keeps saved moments fixed. Existing local dates and times may change, so confirm that consequence before saving.
    </div>
}
<form method="post">
    <input asp-for="ExpectedVersion" type="hidden">
    <div asp-validation-summary="All" class="validation-summary-errors" role="alert" tabindex="-1" data-focus-target="@(ViewData.ModelState.IsValid ? "false" : "true")"></div>
    <div class="form-group">
        <label asp-for="TimeZoneId">Group time zone</label>
        <select asp-for="TimeZoneId">
            <option value="">Choose a local time zone</option>
            <option value="America/New_York">New York — Eastern time</option>
            <option value="America/Chicago">Chicago — Central time</option>
            <option value="America/Denver">Denver — Mountain time</option>
            <option value="America/Los_Angeles">Los Angeles — Pacific time</option>
            <option value="America/Phoenix">Phoenix — Arizona time</option>
            <option value="Europe/London">London — United Kingdom time</option>
            <option value="Europe/Berlin">Berlin — Central European time</option>
            <option value="Australia/Sydney">Sydney — Eastern Australia time</option>
            <option value="Etc/UTC">Coordinated universal time</option>
        </select>
        <p class="field-help">Choose a familiar city or region from the list. It controls local schedule times.</p>
        <span asp-validation-for="TimeZoneId"></span>
    </div>
    @if (Model.Settings is not null)
    {
        <div class="form-group check-row">
            <input asp-for="ConfirmDisplayChange" type="checkbox">
            <label asp-for="ConfirmDisplayChange">I understand that existing local displays may change.</label>
        </div>
    }
    <div class="actions"><button type="submit">Save group time zone</button></div>
</form>
