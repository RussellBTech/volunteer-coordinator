@page "/Coordinator/Requests"
@using VolunteerCoordinator.Web.Presentation
@using VolunteerCoordinator.Domain.Schedules
@model VolunteerCoordinator.Web.Pages.Coordinator.Requests.IndexModel
@inject GroupTimeFormatter Formatter
@{
    ViewData["Title"] = "Requests to review";
}
<header class="page-heading">
    <div>
        <p class="eyebrow">Routine work</p>
        <h1 tabindex="-1">@(Model.IsFiltered ? "Requests to review" : "Volunteer requests")</h1>
        <p class="lead">Review each volunteer request before anyone is assigned. Local dates and commitment details stay visible beside the decision.</p>
    </div>
    @if (Model.IsFiltered)
    {
        <a class="button button-secondary" asp-page="/Coordinator/Requests/Index">Show all requests</a>
    }
</header>
@if (TempData["Error"] is string error) { <div class="alert alert-error" role="alert">@error</div> }
@if (Model.Requests.Count == 0)
{
    <div class="empty-state">
        <p class="eyebrow">No matching work</p>
        <h2>@(Model.IsFiltered ? "No requests need review" : "No volunteer requests")</h2>
        <p>@(Model.IsFiltered ? "Every current and future request is resolved or already assigned." : "Requests will appear here after published openings are requested.")</p>
        <a class="button button-secondary" asp-page="/Coordinator/Index">Back to coordinator home</a>
    </div>
}
else
{
<div class="table-scroll"><table class="responsive">
<caption class="visually-hidden">Volunteer requests</caption>
<thead><tr><th>Volunteer</th><th>Commitment</th><th>Requested</th><th>Request status</th><th>Commitment state</th><th>Next action</th></tr></thead>
<tbody>
@foreach (var request in Model.Requests)
{
<tr id="request-@request.RequestId.ToString("N")">
<td data-label="Volunteer">@request.VolunteerName<br><small>@request.VolunteerEmail</small></td>
<td data-label="Commitment">
    <div class="commitment-summary">
        <strong>@request.Commitment.ShiftTitle</strong>
        <time datetime="@Formatter.UtcDateTime(request.Commitment.StartsAtUtc)">@Formatter.FormatLocal(request.Commitment.StartsAtUtc, request.Commitment.GroupTimeZoneId)</time>
        <span>@request.Commitment.SlotLabel</span>
        <details class="supporting-details">
            <summary>Full commitment details</summary>
            <partial name="_CommitmentDetails" model="request.Commitment" />
        </details>
    </div>
</td>
<td data-label="Requested"><time datetime="@Formatter.UtcDateTime(request.RequestedAtUtc)">@Formatter.FormatLocal(request.RequestedAtUtc, request.Commitment.GroupTimeZoneId)</time></td>
<td data-label="Request status"><span class="status-chip status-chip-@request.Status.ToLowerInvariant()">@(request.Status switch { "Pending" => "Request to review", "Approved" => "Approved", "Rejected" => "Declined", "Superseded" => "Resolved", _ => "Resolved" })</span></td>
<td data-label="Commitment state">@(request.SlotState switch { "Unconfirmed" => "Waiting for confirmation", "Available" => "Open", "Confirmed" => "Confirmed", "Inactive" or "Ended" => "Resolved", _ => "Status unavailable" })</td>
<td data-label="Next action">
@if (request.Status == "Pending")
{
<div class="actions">
@if (request.CanApprove)
{
<form method="post" asp-page-handler="Approve" class="inline"><input type="hidden" name="id" value="@request.RequestId"><button type="submit">Approve and assign</button></form>
}
<form method="post" asp-page-handler="Reject" class="inline"><input type="hidden" name="id" value="@request.RequestId"><button type="submit" class="text-button danger-link">Decline request</button></form>
</div>
}
else { <span>No action needed</span> }
</td>
</tr>
}
</tbody></table></div>
}
@if (Model.RecurringRequests.Count > 0)
{
    <section class="card" aria-labelledby="recurring-requests-heading">
        <h2 id="recurring-requests-heading">Recurring requests</h2>
        <p>Each row covers one finite cadence. Approval creates assignments, then the volunteer confirms the cadence once through the private hub.</p>
        <div class="table-scroll">
            <table class="responsive">
                <caption class="visually-hidden">Recurring volunteer requests</caption>
                <thead><tr><th>Volunteer</th><th>Recurring commitment</th><th>Range</th><th>Policy</th><th>Dates</th><th>Next action</th></tr></thead>
                <tbody>
                @foreach (var request in Model.RecurringRequests)
                {
                    <tr id="request-@request.RequestId.ToString("N")">
                        <td data-label="Volunteer">@request.VolunteerName<br><small>@request.VolunteerEmail</small></td>
                        <td data-label="Recurring commitment">@request.Title<br><small>@request.RoleLabel</small></td>
                        <td data-label="Range">@request.EffectiveLocalDate.ToString("MMMM d, yyyy") through @request.EndLocalDate.ToString("MMMM d, yyyy")</td>
                        <td data-label="Policy">@(request.SourcePolicy == SignupPolicy.DirectClaim ? "Direct claim" : "Coordinator review")</td>
                        <td data-label="Dates">@request.IncludedCount included, @request.SkippedCount unavailable</td>
                        <td data-label="Next action">
                            @if (request.CanApprove)
                            {
                                <form method="post" asp-page-handler="ApproveRecurring" class="inline"><input type="hidden" name="id" value="@request.RequestId"><button type="submit">Approve recurring request</button></form>
                                <form method="post" asp-page-handler="RejectRecurring" class="inline"><input type="hidden" name="id" value="@request.RequestId"><button type="submit" class="text-button danger-link">Decline recurring request</button></form>
                            }
                            else if (request.RecurringCommitmentId is Guid commitmentId)
                            {
                                <a class="button button-secondary" asp-page="/Coordinator/Recurring/Handoff" asp-route-id="@commitmentId">Review recurring handoff</a>
                            }
                            else
                            {
                                <span>No action needed</span>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
}
