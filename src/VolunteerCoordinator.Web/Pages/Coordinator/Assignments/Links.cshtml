@page "/Coordinator/Assignments/Links/{assignmentId:guid}"
@model VolunteerCoordinator.Web.Pages.Coordinator.Assignments.LinksModel
@{
    ViewData["Title"] = "Volunteer action links";
}
<h1 tabindex="-1">Volunteer action links</h1>
@if (Model.Error is not null)
{
    <div class="alert alert-error" role="alert">@Model.Error</div>
}
@if (Model.Commitment is not null)
{
    <div class="card"><partial name="_CommitmentDetails" model="Model.Commitment" /></div>
}
<p>Generating links invalidates earlier unused links of the same action. Raw links are never stored and are displayed only on the next page load.</p>
@if (Model.Links.Count > 0)
{
<div class="alert alert-warning" role="status">Copy these links now. They will not be shown again.</div>
@foreach (var link in Model.Links)
{
<div class="form-group"><strong>@link.Key</strong><a class="copy-value" href="@link.Value">@link.Value</a></div>
}
}
else if (Model.Error is null)
{
<form method="post"><button type="submit">Generate fresh valid action links</button></form>
}
<p><a class="button button-secondary" asp-page="/Coordinator/Coverage/Index">Return to coverage</a></p>
