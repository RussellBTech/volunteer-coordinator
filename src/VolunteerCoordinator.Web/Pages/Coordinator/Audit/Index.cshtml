@page "/Coordinator/Audit"
@using VolunteerCoordinator.Web.Presentation
@model VolunteerCoordinator.Web.Pages.Coordinator.Audit.IndexModel
@inject GroupTimeFormatter Formatter
@{
    ViewData["Title"] = "History";
}
<header class="page-heading">
    <div>
        <p class="eyebrow">Coordinator record</p>
        <h1 tabindex="-1">History</h1>
        <p class="lead">Recent schedule and volunteer-work changes, shown in the group’s local time.</p>
    </div>
</header>
@if (Model.Entries.Count == 0)
{
    <div class="empty-state"><h2>No history yet</h2><p>Coordinator actions will appear here as work is completed.</p></div>
}
else
{
<div class="table-scroll"><table class="responsive">
<caption class="visually-hidden">Coordinator history</caption>
<thead><tr><th>When</th><th>Coordinator</th><th>What happened</th></tr></thead><tbody>
@foreach (var entry in Model.Entries)
{
<tr>
    <td data-label="When"><time datetime="@Formatter.UtcDateTime(entry.OccurredAtUtc)">@Formatter.FormatLocal(entry.OccurredAtUtc, entry.GroupTimeZoneId)</time></td>
    <td data-label="Coordinator">@entry.ActorDisplay</td>
    <td data-label="What happened">@entry.Summary</td>
</tr>
}
</tbody></table></div>
}
