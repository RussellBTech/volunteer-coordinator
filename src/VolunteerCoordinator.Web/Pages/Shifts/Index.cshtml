@page "/Shifts"
@model VolunteerCoordinator.Web.Pages.Shifts.IndexModel
@{
    ViewData["Title"] = "Open shifts";
}
<h1 tabindex="-1">Open shifts</h1>
@if (!Model.IsTimeZoneConfigured)
{
    <div class="alert alert-warning" role="status">Commitment times are temporarily unavailable. Please contact the coordinator.</div>
}
else if (Model.Openings.Count == 0)
{
    <div class="empty-state">
        <h2>No openings are published</h2>
        <p>There are currently no future open slots. Please check again later.</p>
    </div>
}
else
{
    <p class="lead">Published primary and backup opportunities that still need a volunteer. Times are shown in the group's local time.</p>
    <div class="grid">
    @foreach (var opening in Model.Openings)
    {
        <article class="card">
            <partial name="_CommitmentDetails" model="opening.Commitment" />
            <p><span class="badge badge-open">@opening.Status</span></p>
            <a class="button" asp-page="/Shifts/Request" asp-route-slotId="@opening.SlotId">@(opening.Commitment.SignupPolicy == VolunteerCoordinator.Domain.Schedules.SignupPolicy.DirectClaim ? "Claim this commitment" : "Request this " + opening.SlotLabel.ToLowerInvariant() + " slot")</a>
        </article>
    }
    </div>
}
@if (Model.RecurringSeries.Count > 0)
{
    <section class="card" aria-labelledby="recurring-openings-heading">
        <h2 id="recurring-openings-heading">Serve regularly</h2>
        <p>Choose a finite recurring cadence for a published schedule. Exact included and unavailable dates are reviewed before submission.</p>
        <div class="grid">
        @foreach (var series in Model.RecurringSeries.Where(x => x.IsActive))
        {
            <article class="card">
                <h3>@series.Title</h3>
                <p>@series.RecurrenceDescription in @series.TimeZoneId</p>
                <p><strong>@series.SignupPolicy</strong> — @(series.SignupPolicy == VolunteerCoordinator.Domain.Schedules.SignupPolicy.DirectClaim ? "First eligible volunteer is confirmed immediately." : "A coordinator reviews each request.")</p>
                <a class="button" asp-page="/Recurring/Index" asp-route-seriesId="@series.Id">Serve regularly</a>
            </article>
        }
        </div>
    </section>
}
