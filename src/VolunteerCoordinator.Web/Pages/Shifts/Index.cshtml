@page "/Shifts"
@model VolunteerCoordinator.Web.Pages.Shifts.IndexModel
@{
    ViewData["Title"] = "Open shifts";
}
<h1>Open shifts</h1>
<p class="lead">Published primary and backup opportunities that still need a volunteer. Times are shown in UTC.</p>
@if (Model.Openings.Count == 0)
{
    <div class="empty-state">
        <h2>No openings are published</h2>
        <p>There are currently no future open slots. Please check again later.</p>
    </div>
}
else
{
    <div class="grid">
    @foreach (var opening in Model.Openings)
    {
        <article class="card">
            <h2>@opening.ShiftTitle</h2>
            <p><span class="badge badge-open">@opening.Status</span> <strong>@opening.SlotLabel</strong></p>
            <p><strong>Starts:</strong> <time datetime="@opening.StartsAtUtc.ToString("O")">@opening.StartsAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'")</time><br>
               <strong>Ends:</strong> <time datetime="@opening.EndsAtUtc.ToString("O")">@opening.EndsAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'")</time></p>
            @if (opening.Location is not null) { <p><strong>Location:</strong> @opening.Location</p> }
            <a class="button" asp-page="/Shifts/Request" asp-route-slotId="@opening.SlotId">Request this @opening.SlotLabel.ToLowerInvariant() slot</a>
        </article>
    }
    </div>
}
