@page "/Commitments/Recover/{token}"
@model VolunteerCoordinator.Web.Pages.Commitments.RecoverTokenModel
@{
    ViewData["Title"] = "Recover commitment access";
}
<h1 tabindex="-1">Recover commitment access</h1>
@if (Model.Error is not null)
{
    <div class="alert alert-error" role="alert">@Model.Error</div>
}
<p>To protect private commitment access, this link is inspected on this page and redeemed only after you submit the form.</p>
<form method="post">
    <button type="submit">Redeem recovery link</button>
</form>
